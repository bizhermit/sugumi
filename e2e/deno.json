{
  "imports": {
    "playwright": "npm:playwright@1.64.1"
  },
  "permissions": {
    "test": {
      "net": true,
      "read": ["../dist/e2e", "/usr/local/share/ms-playwright"],
      "write": ["../dist/e2e"],
      "run": [
        "/usr/local/share/ms-playwright/chromium_headless_shell-1248/chrome-headless-shell-linux64/chrome-headless-shell"
      ],
      "sys": ["homedir", "osRelease", "uid"],
      "env": true
    }
  },
  "tasks": {
    "test": "deno test -P=test"
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "preserve"
  }
}
