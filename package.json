{
  "name": "myapp",
  "version": "0.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "imports": {
    "#jsx/jsx-runtime": {
      "types": "./src/web/jsx-runtime.ts",
      "default": "./dist/src/web/jsx-runtime.js"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:assets",
    "build:assets": "node scripts/build-assets.ts",
    "start": "node dist/src/main.js",
    "check": "tsc --noEmit && tsc -p tsconfig.client.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "migrate": "node src/migrate.ts",
    "test": "tsc && npm run build:assets && node --test dist/tests/",
    "build:image": "node scripts/build-image.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
