{
  "permissions": {
    "default": {
      "net": true,
      "read": ["src", "dist", "data"],
      "write": ["data"],
      "env": [
        "PORT",
        "LOGIN_LOCKOUT_MINUTES",
        "LOGIN_MAX_FAILED_ATTEMPTS",
        "SESSION_IDLE_TIMEOUT_MINUTES",
        "SESSION_ABSOLUTE_TIMEOUT_MINUTES",
        "PRE_LOGIN_CSRF_TIMEOUT_MINUTES"
      ]
    },
    "gen": {
      "read": ["src/pages", "src/routes.gen.ts"],
      "write": ["src/routes.gen.ts"]
    },
    "check-imports": {
      "read": ["src", "scripts"]
    },
    "account": {
      "read": ["src", "data"],
      "write": ["data"],
      "env": [
        "PORT",
        "LOGIN_LOCKOUT_MINUTES",
        "LOGIN_MAX_FAILED_ATTEMPTS",
        "SESSION_IDLE_TIMEOUT_MINUTES",
        "SESSION_ABSOLUTE_TIMEOUT_MINUTES",
        "PRE_LOGIN_CSRF_TIMEOUT_MINUTES"
      ]
    }
  },
  "tasks": {
    "dev": "deno task build && (deno task gen --watch & deno task bundle --watch & deno run --watch=src/pages/,dist/public/ -P src/main.ts)",
    "gen": "deno run -P=gen scripts/gen-routes.ts",
    "start": "deno run -P src/main.ts",
    "build": "rm -rf dist/public && deno task bundle",
    "bundle": "deno bundle --platform browser --minify --sourcemap=external --code-splitting --outdir dist/public src/**/_assets/index.ts src/**/_assets/index.css",
    "check:imports": "deno run -P=check-imports scripts/check-imports.ts",
    "account:add": "deno run -P=account scripts/add-account.ts"
  },
  "fmt": {
    "lineWidth": 100
  }
}
