{
  "exclude": ["e2e/"],
  "lock": { "frozen": true },
  "unstable": ["no-legacy-abort"],
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "#jsx"
  },
  "imports": {
    "#jsx/jsx-runtime": "./src/lib/jsx-runtime.ts",
    "pg": "npm:pg@8.23.1"
  },
  "permissions": {
    "default": {
      "net": true,
      "read": ["src", "dist/public", "static", "/run/secrets"],
      "env": {
        "allow": [
          "APP_MODE",
          "DATABASE_URL",
          "DATABASE_PASSWORD_FILE",
          "PG*",
          "PORT",
          "DB_POOL_MAX",
          "DB_CONNECTION_TIMEOUT_SECONDS",
          "DB_STATEMENT_TIMEOUT_SECONDS",
          "REQUEST_BODY_TIMEOUT_SECONDS",
          "LOGIN_LOCKOUT_MINUTES",
          "LOGIN_MAX_FAILED_ATTEMPTS",
          "LOGIN_DEVICE_DAYS",
          "LOGIN_IP_MAX_FAILED_ATTEMPTS",
          "LOGIN_IP_WINDOW_MINUTES",
          "LOGIN_IP_LOCKOUT_MINUTES",
          "SESSION_IDLE_TIMEOUT_MINUTES",
          "SESSION_ABSOLUTE_TIMEOUT_MINUTES",
          "PRE_LOGIN_CSRF_TIMEOUT_MINUTES",
          "TRUSTED_PROXIES"
        ],
        "ignore": ["USER", "NODE_PG_FORCE_NATIVE"]
      }
    },
    "gen": {
      "read": ["src/routes", "src/routes.gen.ts"],
      "write": ["src/routes.gen.ts"]
    },
    "check-imports": {
      "read": ["src", "scripts"]
    },
    "check-bundle": {
      "read": ["dist/public"]
    },
    "test": {
      "net": true,
      "read": ["src", "dist/public", "dist/test", "static", "deno.lock", "e2e/deno.lock"],
      "write": ["dist/test"],
      "env": {
        "allow": [
          "APP_MODE",
          "DATABASE_URL",
          "DATABASE_PASSWORD_FILE",
          "PG*",
          "PORT",
          "DB_POOL_MAX",
          "DB_CONNECTION_TIMEOUT_SECONDS",
          "DB_STATEMENT_TIMEOUT_SECONDS",
          "REQUEST_BODY_TIMEOUT_SECONDS",
          "LOGIN_LOCKOUT_MINUTES",
          "LOGIN_MAX_FAILED_ATTEMPTS",
          "LOGIN_DEVICE_DAYS",
          "LOGIN_IP_MAX_FAILED_ATTEMPTS",
          "LOGIN_IP_WINDOW_MINUTES",
          "LOGIN_IP_LOCKOUT_MINUTES",
          "SESSION_IDLE_TIMEOUT_MINUTES",
          "SESSION_ABSOLUTE_TIMEOUT_MINUTES",
          "PRE_LOGIN_CSRF_TIMEOUT_MINUTES",
          "TRUSTED_PROXIES"
        ],
        "ignore": ["USER", "NODE_PG_FORCE_NATIVE"]
      }
    },
    "test-e2e": {
      "net": true,
      "run": ["deno"],
      "write": ["dist/e2e"],
      "env": {
        "allow": [
          "APP_MODE",
          "DATABASE_URL",
          "DATABASE_PASSWORD_FILE",
          "PG*",
          "PORT",
          "DB_POOL_MAX",
          "DB_CONNECTION_TIMEOUT_SECONDS",
          "DB_STATEMENT_TIMEOUT_SECONDS",
          "REQUEST_BODY_TIMEOUT_SECONDS",
          "LOGIN_LOCKOUT_MINUTES",
          "LOGIN_MAX_FAILED_ATTEMPTS",
          "LOGIN_DEVICE_DAYS",
          "LOGIN_IP_MAX_FAILED_ATTEMPTS",
          "LOGIN_IP_WINDOW_MINUTES",
          "LOGIN_IP_LOCKOUT_MINUTES",
          "SESSION_IDLE_TIMEOUT_MINUTES",
          "SESSION_ABSOLUTE_TIMEOUT_MINUTES",
          "PRE_LOGIN_CSRF_TIMEOUT_MINUTES",
          "TRUSTED_PROXIES",
          "E2E_BASE_URL"
        ],
        "ignore": ["USER", "NODE_PG_FORCE_NATIVE"]
      }
    },
    "account": {
      "read": ["src", "/run/secrets"],
      "net": true,
      "env": {
        "allow": [
          "APP_MODE",
          "DATABASE_URL",
          "DATABASE_PASSWORD_FILE",
          "PG*",
          "PORT",
          "DB_POOL_MAX",
          "DB_CONNECTION_TIMEOUT_SECONDS",
          "DB_STATEMENT_TIMEOUT_SECONDS",
          "REQUEST_BODY_TIMEOUT_SECONDS",
          "LOGIN_LOCKOUT_MINUTES",
          "LOGIN_MAX_FAILED_ATTEMPTS",
          "LOGIN_DEVICE_DAYS",
          "LOGIN_IP_MAX_FAILED_ATTEMPTS",
          "LOGIN_IP_WINDOW_MINUTES",
          "LOGIN_IP_LOCKOUT_MINUTES",
          "SESSION_IDLE_TIMEOUT_MINUTES",
          "SESSION_ABSOLUTE_TIMEOUT_MINUTES",
          "PRE_LOGIN_CSRF_TIMEOUT_MINUTES",
          "TRUSTED_PROXIES"
        ],
        "ignore": ["USER", "NODE_PG_FORCE_NATIVE"]
      }
    }
  },
  "tasks": {
    "dev": "APP_MODE=DEV deno task watch",
    "dev:mock": "APP_MODE=MOCK deno task watch",
    "dev:prod": "APP_MODE=PROD deno task watch",
    "watch": "deno task build && (deno task gen --watch & deno task bundle --watch & deno run --watch=src/routes/,dist/public/,static/ -P src/main.ts)",
    "gen": "deno run -P=gen scripts/gen-routes.ts",
    "start": "deno run -P src/main.ts",
    "build": "rm -rf dist/public && deno task check:imports && deno task bundle && deno task check:bundle",
    "bundle": "deno bundle --platform browser --minify --sourcemap=external --code-splitting --outdir dist/public src/**/_assets/index.ts src/**/_assets/index.css",
    "check:imports": "deno run -P=check-imports scripts/check-imports.ts",
    "check:bundle": "deno run -P=check-bundle scripts/check-bundle.ts",
    "account:add": "deno run -P=account scripts/add-account.ts",
    "account:unlock": "deno run -P=account scripts/unlock-account.ts",
    "test": "(test -n \"$TEST_DATABASE_URL\" || (echo '環境変数 TEST_DATABASE_URL を設定してください' >&2 && exit 1)) && DATABASE_URL=$TEST_DATABASE_URL deno test -P=test",
    "test:e2e": "(test -n \"$TEST_DATABASE_URL\" || (echo '環境変数 TEST_DATABASE_URL を設定してください' >&2 && exit 1)) && deno task build && DATABASE_URL=$TEST_DATABASE_URL deno run -P=test-e2e scripts/test-e2e.ts",
    "bench": "(test -n \"$TEST_DATABASE_URL\" || (echo '環境変数 TEST_DATABASE_URL を設定してください' >&2 && exit 1)) && DATABASE_URL=$TEST_DATABASE_URL deno bench -P=test"
  },
  "lint": {
    "rules": {
      "exclude": ["jsx-key"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "preserve"
  }
}
