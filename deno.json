{
  "exclude": [
    "dist/",
    "local/"
  ],
  "fmt": {
    "lineWidth": 120,
    "proseWrap": "preserve",
    "quoteProps": "asNeeded"
  },
  "tasks": {
    "dev": "deno run --watch --allow-net src/main.ts",
    "start": "deno run --allow-net src/main.ts",
    "build:image": "deno run --allow-run=git,docker --allow-write=dist scripts/build-image.ts"
  }
}
