  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2025"],
    "types": [],
    "isolatedDeclarations": true,
    "rootDir": ".",
    "outDir": "../../../../dist/services/admin/shared",
    "tsBuildInfoFile": "../../../../dist/services/admin/shared/.tsbuildinfo"
  },
  "include": ["**/*.ts"],
