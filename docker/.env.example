# 本番の compose.yaml が --env-file で読み込む。docker/.env にコピーして値を書く（docker/.env はコミットしない）
# 値は単一引用符で囲む。囲まないと $ が変数として展開される。値に ' は使えない
# パスワードを空のままにすると、/run/secrets/ のファイルが作られず、DB が起動しない

# DB の管理者のパスワード
DB_ADMIN_PASSWORD=''
# アプリが DB に接続するユーザー app のパスワード
DB_APP_PASSWORD=''

# アプリのコンテナを置くネットワーク。サーバーのほかのネットワーク（ほかの Docker のネットワーク、LAN、VPN）と
# 重ならない範囲を選ぶ（ip route や docker network inspect で、使われている範囲を確かめる）。
# 重なると、起動時に Pool overlaps のエラーになる。例：APP_NETWORK_SUBNET='172.30.255.0/24'
APP_NETWORK_SUBNET=''
# 上の範囲の中のアドレス。ふつうは範囲の最初のアドレスにする。例：APP_NETWORK_GATEWAY='172.30.255.1'
# 同じサーバーのリバースプロキシから 127.0.0.1:3000 へ転送すると、アプリにはこのアドレスから接続したように見える
APP_NETWORK_GATEWAY=''

# アプリの設定。書かなければアプリの既定値を使う
# LOGIN_LOCKOUT_MINUTES=60
# LOGIN_MAX_FAILED_ATTEMPTS=5
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
# PRE_LOGIN_CSRF_TIMEOUT_MINUTES=60
# 信頼するプロキシの IP アドレス（カンマ区切り。CIDR でも書ける）。監査ログに利用者のアドレスを出すために書く。
# 同じサーバーのリバースプロキシから転送するなら、APP_NETWORK_GATEWAY と同じ値を書く。
# このアドレスから届いた X-Forwarded-For を信用するため、リバースプロキシで X-Forwarded-For の右端に接続元を
# 追記するか、接続元だけで上書きする（README を参照）。何もしないと、利用者が送った値がそのまま届き、偽れる。
# プロキシのアドレスだけを書く。範囲を広げると、その中の端末が X-Forwarded-For で接続元を偽れる。
# 同じサーバーのプロセスは、127.0.0.1:3000 に直接つなげば、どれもこのアドレスから届くため偽れる。
# 信頼しない利用者やサービスを同じサーバーに置かない
# TRUSTED_PROXIES=''
