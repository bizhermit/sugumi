#!/bin/sh
# マイグレーション（docker/db/migrations/ の SQL ファイル）のうち、まだ適用していないものを、番号順に 1 つのトランザクションで適用する。
# スキーマを持つ DB ユーザー migrator で実行する。アプリ（app）はスキーマを変更できず、マイグレーションにも関わらない。
#
# - 本番：DB のコンテナの中で、引数なしで実行する（docker compose exec db db-migrate）。コンテナの中からはパスワードなしで接続できる。
# - 開発・テスト：deno task migrate・migrate:test（scripts/migrate.ts）が、接続先の URL を引数に、MIGRATIONS_DIR にリポジトリのディレクトリを渡す。
# - --check：DB に接続せず、ファイル名と番号だけを確かめ、最後の番号を出力する。deno task gen（scripts/gen-schema-version.ts）が使う。
#
# ファイル名は「4 桁の番号_説明.sql」（英小文字・数字・_・-）。番号は 0001 から欠けずに続け、適用済みのファイルは書き換えない。
# 番号が schema_migrations のバージョンになる。アプリは、src/lib/schema-version.gen.ts の SCHEMA_VERSION と同じでないと起動しない。
set -eu

# psql のバッククォートの中では、: で始まる変数が展開され、バッククォートで区切られる。
# パスに何が入っていても読めるよう、ディレクトリはシェルの環境変数で渡し、psql にはその名前と確かめたファイル名だけを書く。
MIGRATIONS_DIR=${MIGRATIONS_DIR:-/migrations}
export MIGRATIONS_DIR

# 適用する SQL を組み立てる。ファイル名を先にすべて確かめ、1 つでもおかしければ、何も適用せずに終わる。
build() {
  cat <<'SQL'
\o /dev/null
BEGIN;
-- 2 人が同時に実行しても、1 つずつ適用する
SELECT pg_advisory_xact_lock(7316001);
-- マイグレーションが search_path を変えても、別のスキーマに記録しないよう、スキーマを付けて書く。
CREATE TABLE IF NOT EXISTS app.schema_migrations (
  version integer PRIMARY KEY,
  applied_at timestamptz NOT NULL DEFAULT now()
);
-- アプリが読めるのは、起動時にバージョンを確かめるため。書き換えさせない
REVOKE INSERT, UPDATE, DELETE, TRUNCATE ON app.schema_migrations FROM app;
SELECT coalesce(max(version), 0) AS from_version FROM app.schema_migrations \gset
SQL
  expected=1
  for file in "$MIGRATIONS_DIR"/*.sql; do
    [ -e "$file" ] || break
    name=${file##*/}
    case $name in
    [0-9][0-9][0-9][0-9]_*.sql) ;;
    *)
      echo "マイグレーションのファイル名は「4 桁の番号_説明.sql」にしてください: $name" >&2
      exit 1
      ;;
    esac
    case ${name%.sql} in
    *[!0-9a-z_-]*)
      echo "マイグレーションのファイル名に使えない文字があります（英小文字・数字・_・- だけ）: $name" >&2
      exit 1
      ;;
    esac
    # 先頭の 0 を 8 進数と読ませないよう、1 を付けてから引く。
    version=$((1${name%%_*} - 10000))
    if [ "$version" -ne "$expected" ]; then
      echo "マイグレーションの番号が続いていません（$expected のはず）: $name" >&2
      exit 1
    fi
    # ファイルの中身は psql に読ませず、PL/pgSQL の EXECUTE で実行する。
    # psql のメタコマンド（\! など）でコンテナの中のコマンドを動かしたり、COMMIT で途中まで確定させたりできないようにするため
    # （トランザクションの中の DO では、COMMIT・ROLLBACK はエラーになる）。
    cat <<SQL
SELECT :from_version >= $version AS skip \gset
\if :skip
\else
\echo 適用します: $name
\set migration \`cat "\$MIGRATIONS_DIR/$name"\`
SELECT set_config('migration.sql', :'migration', true);
DO \$\$
BEGIN
  -- cat が失敗しても psql は空の値で続ける（ON_ERROR_STOP では止まらない）。何も実行せずに適用済みにしない
  IF current_setting('migration.sql') = '' THEN
    RAISE EXCEPTION 'マイグレーションのファイルを読めないか、空です: $name';
  END IF;
  EXECUTE current_setting('migration.sql');
END
\$\$;
INSERT INTO app.schema_migrations (version) VALUES ($version);
\endif
SQL
    expected=$((expected + 1))
  done
  last=$((expected - 1))
  # DB のほうが新しいときは、古いイメージで実行している。知らないマイグレーションが適用済みのまま進めない。
  # psql の変数は $$ の中で展開されないので、DO の中では表を読む。
  cat <<SQL
DO \$\$
BEGIN
  IF (SELECT max(version) FROM app.schema_migrations) > $last THEN
    RAISE EXCEPTION 'DB のスキーマのほうが新しいです。新しいイメージで実行してください: DB % / ファイル %',
      (SELECT max(version) FROM app.schema_migrations), $last;
  END IF;
END
\$\$;
SELECT coalesce(max(version), 0) AS to_version FROM app.schema_migrations \gset
COMMIT;
SELECT :from_version = :to_version AS same \gset
\if :same
\echo 適用するマイグレーションはありません: :to_version
\else
\echo マイグレーションを適用しました: :from_version → :to_version
\endif
SQL
}

# build を $(...) の中で呼ぶと、サブシェルで実行され、last が残らない。
if [ "${1:-}" = --check ]; then
  build >/dev/null
  echo "$last"
  exit 0
fi

sql=$(build)

if [ $# -gt 0 ]; then
  set -- --dbname "$1"
else
  set -- --username migrator --dbname "$POSTGRES_DB"
fi
printf '%s\n' "$sql" |
  PGOPTIONS="-c client_min_messages=warning" psql -v ON_ERROR_STOP=1 --no-psqlrc --quiet "$@"
