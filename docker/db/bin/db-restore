#!/bin/sh
# db-backup で取ったバックアップを標準入力から読み、DB のデータのディレクトリを、その内容で置き換える。
# DB を止めてから、DB のコンテナとは別に起動したコンテナで実行する（docker compose run。docker/README/backup.md を参照）。
# データのディレクトリを書き換えるので、root で実行する。
#
# 今のデータは、バックアップをすべて読み、確かめ終えるまで消さない。途中で失敗したときや中断したときは、元のデータのまま残る。
set -eu

# 動いている DB のデータを書き換えないよう、止めてから実行させる。
# 止めずに強制終了した DB でも残るので、そのときは一度起動してから止める。
if [ -e "$PGDATA/postmaster.pid" ]; then
  echo "DB が動いています。docker compose stop db で止めてから実行してください" >&2
  exit 1
fi

# 置き換えるときに mv で済むよう、データのディレクトリと同じボリュームに展開する。
staging=$(dirname "$PGDATA")/restore
trap 'rm -rf "$staging"' EXIT
rm -rf "$staging"
mkdir -m 700 "$staging"
if ! tar -xzf - -C "$staging"; then
  echo "バックアップを読めません" >&2
  exit 1
fi

version=$(cat "$staging/PG_VERSION" 2>/dev/null || true)
if [ "$version" != "$PG_MAJOR" ]; then
  echo "バックアップの PostgreSQL のメジャーバージョンが、このイメージと違います: バックアップ ${version:-不明} / イメージ $PG_MAJOR" >&2
  exit 1
fi
chown -R postgres:postgres "$staging"

# バックアップのファイルが欠けたり壊れたりしていないかを、pg_basebackup が付けた backup_manifest と照らし合わせて確かめる。
# 書き換えられたバックアップは、backup_manifest ごと作り直せるので、見分けられない。
if ! gosu postgres pg_verifybackup --quiet "$staging"; then
  echo "バックアップが壊れています" >&2
  exit 1
fi
# 次に db-backup で取るときに、データのディレクトリの backup_manifest と、pg_basebackup が付けるものが重ならないようにする。
rm "$staging/backup_manifest"

rm -rf "$PGDATA"
mv "$staging" "$PGDATA"
