#!/bin/sh
# スキーマ app のテーブルのバックアップを、pg_dump の custom 形式で標準出力に書き出す。戻すときは db-restore に渡す。
# pg_dump は 1 つのスナップショットから読むので、アプリが書き込んでいる最中でも、ある時点のそろった状態になる。
#
# テーブル（と、それに付くインデックス・制約・シーケンス）だけを対象にする。スキーマ自体を含めると、
# 復元のときにスキーマを作る権限（管理者）が要るため（db-restore を参照）。
# マイグレーションで関数や型を足すときは、ここを見直す。
set -eu

exec pg_dump --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --table='app.*' --format=custom
