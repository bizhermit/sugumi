#!/bin/sh
# DB ユーザー migrator が持つすべてのスキーマ（テーブル・ビュー・関数・型・権限を含む）のバックアップを、
# pg_dump の custom 形式で標準出力に書き出す。戻すときは db-restore に渡す。
# pg_dump は 1 つのスナップショットから読むので、アプリが書き込んでいる最中でも、ある時点のそろった状態になる。
#
# スキーマはマイグレーションで足せるので、決め打ちせず、実行のたびに migrator が持つものを調べる。
# quote_ident で引用符を付け、pg_dump がワイルドカードや大文字小文字を読み替えないようにする。
set -eu

schemas=$(psql --no-psqlrc -At --username migrator --dbname "$POSTGRES_DB" \
  -c "SELECT quote_ident(nspname) FROM pg_catalog.pg_namespace WHERE nspowner = 'migrator'::regrole ORDER BY 1")
set --
for schema in $schemas; do
  set -- "$@" "--schema=$schema"
done
if [ $# -eq 0 ]; then
  echo "migrator が持つスキーマがありません" >&2
  exit 1
fi

exec pg_dump --username migrator --dbname "$POSTGRES_DB" --format=custom "$@"
