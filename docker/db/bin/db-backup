#!/bin/sh
# DB 全体（すべての DB・DB ユーザー・パスワード・設定を含む）のバックアップを、pg_basebackup の tar 形式を gzip で圧縮して、
# 標準出力に書き出す。戻すときは db-restore に渡す。
# DB を動かしたまま取れる。取っている間の WAL も含めるので、復元すると、取り終えた時点のそろった状態になる。
#
# レプリケーションの接続で読むので、管理者で接続する（conf/pg_hba.conf）。
set -eu

# --wal-method=fetch：WAL を最後にまとめて読み、同じ tar に入れる。標準出力に書くときは、stream を使えない。
#   取っている間に書き込みが多いと、読む前に WAL が消されて失敗する。そのときは取り直す。
# --checkpoint=fast：すぐに取り始める。デフォルトでは、次の定期のチェックポイントまで待つことがある。
exec pg_basebackup --username "$POSTGRES_USER" --pgdata=- --format=tar --gzip \
  --wal-method=fetch --checkpoint=fast
