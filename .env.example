# sugumi の環境変数の雛形。
#
# - **どんなキーがあるか**の正本は規約 §6.5 の設定項目表である。本ファイルはその写しであり、
#   既定値・上限・検証規則は書かない（§6.5 / §11.8）。
# - **値はすべてプレースホルダである。実値（実ホスト名・絶対パス・鍵・トークン）を1つも書かない。**
# - 本ファイルはコミットする。`.env` はコミットしない（§11.6 の `.gitignore`）。
# - 読み込みは `node --env-file=.env`（§6.5）。`.env` は permission model の適用より前に処理されるため、
#   `--allow-fs-read` には列挙しない（実測 F17。§6.5）。
# - キー集合は §6.5 の表・`docs/operations.md`・`src/platform/server/config/` と
#   4方向で一致していること（§12.4-49。フェーズ2投入）。

# ---- 必須 ----

APP_ENV=<development | production>

# 単一サービスの host（`src/hosts/app` / `src/hosts/admin`）で使う形。
HOST=<listen するアドレス>
PORT=<listen するポート番号>
BASE_URL=<スキームとホストのみ。末尾スラッシュ・パス・クエリ・フラグメントを付けない>

# 1プロセスに複数サービスをマウントする host（`src/hosts/dev`）で使う形（§15.3）。
# `<SERVICE_NAME>` は `ServiceName` の union（§15.2）へ展開して列挙する。
# `createConfig` はどちらの形式かを host ごとに固定して検証する（両形式を受け付けない。§6.5）。
PORT_APP=<listen するポート番号>
PORT_ADMIN=<listen するポート番号>
BASE_URL_APP=<スキームとホストのみ>
BASE_URL_ADMIN=<スキームとホストのみ>

# `node:sqlite` のファイルパス。`db/` には置かない（§3.4）。
# `--allow-fs-write` の範囲と一致させること（§6.5。`package.json` の `start:<host>` を参照）。
DATABASE_PATH=<DB ファイルのパス>

# ---- 任意（未設定なら §6.5 の既定値が使われる） ----

SESSION_TTL_SECONDS=<秒>
SESSION_IDLE_TIMEOUT_SECONDS=<秒>

TRUST_PROXY=<true | false>
TRUSTED_PROXY_HOPS=<信頼するプロキシ段数>

# 追加許可ドメイン。値は `'self'` / `'none'` / `https://<host>[:<port>]` のみを受理し、
# 複数指定はカンマ区切りとする（§6.5）。`script-src` への追加許可は設定では行えない（§6.5 / §9.1）。
CSP_EXTRA_CONNECT_SRC=<https://<host> をカンマ区切り>
CSP_EXTRA_IMG_SRC=<https://<host> をカンマ区切り>

MAX_BODY_BYTES=<バイト数>
SESSION_SWEEP_INTERVAL_MS=<ミリ秒>

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=<回数>
LOGIN_RATE_LIMIT_WINDOW_SECONDS=<秒>

DEFAULT_LOCALE=<BCP 47 のロケール>
SUPPORTED_LOCALES=<BCP 47 のロケールをカンマ区切り>

SHUTDOWN_TIMEOUT_MS=<ミリ秒>
LOG_LEVEL=<debug | info | warn | error>
