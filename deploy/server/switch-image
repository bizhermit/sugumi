#!/usr/bin/env bash

set -euo pipefail
cd "$(dirname "$0")"

APP_NAME=myapp

ask() {
  local answer
  read -r -p "$1 [y/N]: " answer
  [ "$answer" = y ] || [ "$answer" = Y ]
}

current=$(sed -n 's/^IMAGE_TAG=//p' .env 2> /dev/null || true)
tags=()
for tag in $(docker images "$APP_NAME/app" --format '{{.Tag}}'); do
  [ "$tag" = "<none>" ] && continue
  [ "$tag" = "$current" ] && continue
  # app と lb の両方がそろっているタグだけを候補にする。
  docker image inspect "$APP_NAME/lb:$tag" > /dev/null 2>&1 || continue
  tags+=("$tag")
done
if [ ${#tags[@]} -eq 0 ]; then
  echo "切り替えられるタグはありません。"
  exit 0
fi

echo "切り替えるタグを番号で選んでください（現在: ${current:-（なし）}）: "
select tag in "${tags[@]}"; do
  [ -n "$tag" ] && break
done
if [ -z "${tag:-}" ]; then
  exit 1
fi

if ! ask "IMAGE_TAGを「${current:-（なし）}」から「$tag」に変更します。よろしいですか？"; then
  exit 0
fi

if grep -q '^IMAGE_TAG=' .env 2> /dev/null; then
  sed -i "s|^IMAGE_TAG=.*|IMAGE_TAG=$tag|" .env
else
  if [ -s .env ] && [ "$(tail -c 1 .env)" != "" ]; then
    echo >> .env
  fi
  echo "IMAGE_TAG=$tag" >> .env
fi
echo "IMAGE_TAGを「$tag」に変更しました。"

if ask "コンテナを起動しますか？"; then
  docker compose up -d
  docker compose ps
fi
